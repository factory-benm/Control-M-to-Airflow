# Exact Apache Airflow pin for the local runtime (docs/migration-design.md,
# Decision 13). Sourced by scripts/lib/airflow.sh. Change all three together:
# the constraints file must be the official one for this version and Python.
AIRFLOW_VERSION=3.3.2
AIRFLOW_PYTHON_VERSION=3.12
AIRFLOW_CONSTRAINTS_URL=https://raw.githubusercontent.com/apache/airflow/constraints-3.3.2/constraints-3.12.txt
