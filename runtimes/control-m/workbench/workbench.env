# BMC Control-M Workbench runtime pin.
#
# Workbench is a no-cost, self-service, standalone Control-M development
# environment, but it is NOT published to a public registry. BMC distributes it
# through its entitled distribution registry, which requires a BMC EPD account
# with permission to download Control-M/Enterprise Manager plus an identity
# token.
#
# Source of truth for these values: https://github.com/controlm/workbench
# (BMC's own quickstart repository).
#
# To enable the real Workbench runtime, export credentials before running
# scripts/controlm-up.sh. Never commit them.
#
#   export BMC_EPD_USER='<your-bmc-epd-user>'
#   export BMC_EPD_TOKEN='<your-bmc-identity-token>'
#
# Alternatively log in once yourself:
#
#   docker login https://distribution.bmc.com -u "$BMC_EPD_USER"
#
# Pinned, never floating.
WORKBENCH_REGISTRY="distribution.bmc.com"
WORKBENCH_IMAGE="distribution.bmc.com/ctmem/workbench"
WORKBENCH_TAG="9.22.50-GA"
WORKBENCH_CONTAINER="payops-controlm-workbench"
WORKBENCH_HOSTNAME="workbench"
WORKBENCH_PORT="8443"
WORKBENCH_CPUS="4"
WORKBENCH_MEMORY="8g"

# BMC's documented minimum is 8GB free memory for the Workbench container.
WORKBENCH_MIN_MEMORY_GB="8"
